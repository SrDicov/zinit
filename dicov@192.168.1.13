#!/bin/sh
doas python3 -c "
p='/etc/zinit/services.d/chronyd.conf'
s=open(p).read()
s=s.replace('command = /usr/bin/chronyd','command = env > /tmp/chronyd-env.txt; exec /usr/bin/chronyd',1)
open(p,'w').write(s)
print('DUMP_ARMED')"
doas /sbin/zctl reload-all >/dev/null 2>&1
sleep 12
grep -c ZINIT_NOTIFY_FD /tmp/chronyd-env.txt 2>/dev/null || echo NO_FILE_OR_NO_VAR
grep "ZINIT_NOTIFY_FD" /tmp/chronyd-env.txt 2>/dev/null | head -n 1
doas /sbin/zctl status chronyd 2>&1 | head -n 1
